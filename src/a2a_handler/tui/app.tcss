Screen {
    padding: 0 1;
    background: $background;
}

* {
    scrollbar-color: $primary 15%;
    scrollbar-color-hover: $primary 75%;
    scrollbar-color-active: $primary;
    scrollbar-background: $surface;
    scrollbar-size-vertical: 1;
}

#server-shell {
    layout: vertical;
    height: 1fr;
}

#server-tab-row {
    height: 2;
    margin-bottom: 0;
    align: left middle;
}

#server-tabs {
    width: 1fr;
    height: 2;
}

#server-tabs Tab {
    background: transparent;
    color: $text-muted;
    padding: 0 1;
}

#server-tabs Tab.-active {
    background: transparent;
    color: $text;
    text-style: bold;
}

#server-tabs Underline > .underline--bar {
    color: $accent;
    background: $surface;
}

#new-server-btn {
    width: auto;
    min-width: 12;
    margin-left: 1;
}

#server-content {
    height: 1fr;
    min-height: 1;
    padding: 0;
    background: $background;
}

ServerTab,
ServerLiveView {
    width: 1fr;
    height: 1fr;
}

ServerConnectView {
    width: 1fr;
    height: auto;
}

#server-content > ServerTab {
    width: 1fr;
    height: 1fr;
}

#server-stage {
    layout: vertical;
    height: 1fr;
}

#connect-shell {
    height: auto;
    border: round $secondary 40%;
    padding: 0 1;
    margin-bottom: 0;
    background: $background;
}

#server-bar {
    height: 1;
    align: left middle;
}

#server-bar > Select,
#server-bar > Input {
    margin-right: 1;
}

#server-select {
    width: 1fr;
    min-width: 20;
}

#manual-agent-url {
    width: 1fr;
    min-width: 20;
}

#server-status-row {
    height: auto;
    width: auto;
    margin-top: 1;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
    text-style: bold;
    min-width: 18;
}

.status-badge.status-info {
    background: $accent 24%;
    color: $text;
}

.status-badge.status-success {
    background: $success 24%;
    color: $text;
}

.status-badge.status-warning {
    background: $warning 24%;
    color: $background;
}

.status-badge.status-error {
    background: $error 24%;
    color: $text;
}

.hidden {
    display: none;
}

#connect-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-gutter: stable;
}

#connect-stage {
    width: 1fr;
    height: auto;
    min-height: 1fr;
    align: center top;
    padding: 0;
}

.connect-canvas {
    width: 1fr;
    height: auto;
    min-height: 1fr;
    align: center top;
    hatch: cross $secondary 16%;
}

#connect-card {
    width: 64;
    max-width: 100%;
    height: auto;
    border: round $secondary 40%;
    border-title-align: right;
    border-title-color: $text-muted;
    background: $surface;
    padding: 1;
}

.connect-eyebrow {
    color: $accent;
    text-style: bold;
    margin-bottom: 0;
}

#connect-title {
    text-style: bold;
    margin-bottom: 0;
}

#connect-subtitle {
    color: $text-muted;
    margin-bottom: 1;
}

#connect-form {
    height: auto;
}

#connect-form > Select,
#connect-form > Input {
    margin-bottom: 0;
}

#launch-mode-subtitle {
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

#launch-mode-container {
    height: auto;
    margin-top: 1;
}

#launch-mode-container.hidden {
    display: none;
}

#launch-mode-selector {
    height: auto;
}

#connect-actions {
    height: auto;
    align: left middle;
    margin-top: 1;
}

#live-stage {
    height: 1fr;
    margin-top: 0;
}

.server-live-layout {
    layout: horizontal;
}

#server-meta {
    width: 1fr;
    height: 1fr;
}

#server-main {
    width: 2fr;
    height: 1fr;
    margin-left: 1;
}

/* Panels - Cockpit Style */
.panel {
    border: round $secondary 40%;
    border-title-align: right;
    border-title-color: $text-muted;
    background: $background;
    padding: 0;
}

.panel:focus-within {
    border: round $accent;
    border-title-color: $text;
    border-title-style: bold;
}

#agent-card-container {
    height: 1fr;
}

#messages-container {
    height: 1fr;
    padding: 0;
}

#input-container {
    height: auto;
    padding: 0 1;
}

#input-row {
    height: auto;
    background: transparent;
    align: left middle;
}

#connection-target {
    width: 1fr;
    min-width: 0;
    height: 3;
    border: none;
    background: transparent;
}

#agent-url {
    background: transparent;
    border: none;
    height: 3;
    padding: 1 1;
    width: 1fr;
    min-width: 20;
}

Button {
    border: none;
    height: 1;
    min-width: 0;
    padding: 0 1;
    background: $surface;
    color: $text;
    text-style: none;
    content-align: center middle;
}

Button:hover {
    background: $primary 20%;
    color: $text;
    text-style: bold;
}

Button:focus {
    background: $primary 25%;
    color: $text;
    text-style: bold;
}

Button:disabled {
    opacity: 40%;
}

#placeholder {
    height: 1fr;
    width: 1fr;
    hatch: cross $secondary 30%;
    align: center middle;
    padding: 1 2;
}

#placeholder Static {
    width: auto;
    text-align: center;
}

#raw-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}

#agent-raw {
    height: auto;
    color: $text;
    padding: 0 1 1 1;
}

Input {
    border: none;
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $text;
}

Input:disabled {
    opacity: 55%;
}

Input:focus {
    padding-left: 0;
    border-left: outer $accent;
}

Input.-invalid {
    padding-left: 0;
    border-left: outer $error;
}

Select {
    height: 1;
    border: none;
    padding: 0;
}

SelectCurrent {
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
    color: $text;
}

Select:focus SelectCurrent {
    padding-left: 0;
    border-left: outer $accent;
}

#message-input {
    border: none;
    height: 1;
    padding: 0 1;
    background: transparent;
    width: 1fr;
}

#send-btn,
#connect-btn {
    width: auto;
    min-width: 7;
    background: $accent 20%;
    color: $text;
    text-style: bold;
}

#connect-btn {
    margin-left: 1;
}

#connect-btn:focus {
    background: $accent;
    color: $text;
}

#messages-tabs {
    height: 1fr;
}

#messages-tabs Tabs {
    height: 2;
}

#messages-tabs Tab {
    background: transparent;
    color: $text-muted;
    padding: 0 1;
}

#messages-tabs Tab.-active {
    background: transparent;
    color: $text;
    text-style: bold;
}

#messages-tabs Underline > .underline--bar {
    color: $accent;
    background: $surface;
}

#messages-tabs ContentSwitcher {
    height: 1fr;
}

#messages-tabs TabPane {
    height: 1fr;
    overflow-y: auto;
    padding: 0;
    border: none;
    background: transparent;
}

#chat {
    height: 1fr;
    scrollbar-size: 1 1;
    padding: 0 1;
}

Message,
AgentMessage {
    margin-bottom: 0;
    height: auto;
    padding: 0 0 1 0;
}

Message.message-user {
    color: $primary;
}

Message.message-system {
    color: $text-muted;
}

AgentMessage {
    color: $success;
}

#logs-panel {
    height: 1fr;
    border: none;
    padding: 0;
    scrollbar-size: 1 1;
    scrollbar-gutter: stable;
    background: $background;
    overflow-x: auto;
    overflow-y: auto;
}

#tasks-panel {
    height: 1fr;
}

#tasks-split {
    height: 1fr;
    layout: horizontal;
}

#tasks-list {
    width: 22;
    height: 1fr;
    border: none;
    scrollbar-size: 1 1;
}

#tasks-list > ListItem {
    padding: 0;
}

#tasks-list > ListItem:hover {
    background: $surface;
}

#tasks-list > ListItem.-highlight {
    background: $primary 30%;
}

#task-detail {
    width: 2fr;
    height: 1fr;
    border-left: solid $secondary 40%;
    padding: 0 1;
    scrollbar-size: 1 1;
}

#task-detail-placeholder {
    color: $text-muted;
}

#task-detail-content.hidden,
#task-detail-placeholder.hidden {
    display: none;
}

#task-detail-content {
    height: auto;
}

#artifacts-panel {
    height: 1fr;
}

#artifacts-split {
    height: 1fr;
    layout: horizontal;
}

#artifacts-list {
    width: 22;
    height: 1fr;
    border: none;
    scrollbar-size: 1 1;
}

#artifacts-list > ListItem {
    padding: 0;
}

#artifacts-list > ListItem:hover {
    background: $surface;
}

#artifacts-list > ListItem.-highlight {
    background: $primary 30%;
}

#artifact-detail {
    width: 2fr;
    height: 1fr;
    border-left: solid $secondary 40%;
    padding: 0 1;
    scrollbar-size: 1 1;
}

#artifact-detail-placeholder {
    color: $text-muted;
}

#artifact-detail-content.hidden,
#artifact-detail-placeholder.hidden {
    display: none;
}

#artifact-detail-content {
    height: auto;
}

.artifact-field-row {
    height: auto;
    width: auto;
}

.artifact-label {
    color: $text-muted;
}

.artifact-value {
    color: $text;
}

.artifact-content {
    height: auto;
    color: $text;
    padding: 0;
}

.section-heading {
    color: $accent;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.task-field-row {
    height: auto;
    width: auto;
}

.task-label {
    color: $text-muted;
}

.task-value {
    color: $text;
}

.task-value-state {
    color: $accent;
}

.artifact-id {
    color: $text;
    text-style: bold;
    margin-top: 1;
}

.artifact-preview {
    height: auto;
    color: $text-muted;
    padding-left: 1;
}

.task-item {
    height: auto;
    color: $text;
}

.history-item {
    height: auto;
    margin-top: 0;
}

.history-role-user {
    color: $primary;
    text-style: bold;
}

.history-role-agent {
    color: $success;
    text-style: bold;
}

.history-message {
    color: $text;
    padding-left: 1;
}

#auth-panel {
    height: auto;
    padding: 0 1 1 1;
}

#auth-panel Label {
    margin-bottom: 0;
}

#auth-panel RadioSet {
    height: auto;
    margin-bottom: 0;
}

#auth-panel Input {
    margin-bottom: 0;
}

#headers-panel {
    height: auto;
    padding: 0 1 1 1;
}

#headers-panel Label {
    margin-bottom: 0;
}

#headers-panel Input {
    margin-bottom: 0;
}

.auth-fields {
    height: auto;
    margin-top: 0;
}

.auth-fields.hidden {
    display: none;
}

AgentCardPanel:focus {
    border: round $accent;
}

TabbedMessagesPanel:focus {
    border: round $accent;
}

Footer {
    background: transparent;
    color: $text-muted;
}

Footer > FooterKey {
    background: transparent;
    color: $text-muted;
}

Footer > FooterKey > .footer-key--key {
    background: $surface;
    color: $text-muted;
}

Footer > FooterKey > .footer-key--description {
    color: $text-muted;
}

CommandPalette {
    align: center top;
}

CommandPalette > Vertical {
    width: 72%;
    min-width: 64;
    max-width: 120;
    height: auto;
    max-height: 18;
    margin-top: 2;
    background: $surface;
}

CommandPalette #--input {
    width: 100%;
    border: none;
    border-left: wide $accent;
}

CommandPalette #--results {
    overlay: none;
    width: 100%;
}

CommandPalette CommandList {
    max-height: 12;
    border: none;
    border-left: wide $accent;
}

#auth-panel.hidden {
    display: none;
}
