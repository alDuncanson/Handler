Screen {
    padding: 1 2;
    background: $background;
}

#workspace-shell {
    layout: vertical;
    height: 1fr;
}

#workspace-tab-row {
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

#workspace-tabs {
    width: 1fr;
    height: auto;
}

#workspace-tabs Tab {
    background: $surface;
    color: $text-muted;
    padding: 0 2;
    margin-right: 1;
}

#workspace-tabs Tab.-active {
    background: $primary;
    color: $background;
    text-style: bold;
}

#new-workspace-btn {
    width: auto;
    min-width: 16;
    margin-left: 1;
}

#workspace-content {
    height: 1fr;
    min-height: 1;
    border: round $primary;
    padding: 0 1;
    background: $background;
}

RemoteWorkspace,
RemoteConnectView,
RemoteLiveView {
    width: 1fr;
    height: 1fr;
}

#workspace-content > RemoteWorkspace {
    width: 1fr;
    height: 1fr;
}

#connect-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-gutter: stable;
}

#connect-stage {
    width: 1fr;
    height: auto;
    min-height: 1fr;
    align: center top;
    padding: 1 0;
}

.connect-canvas {
    width: 1fr;
    height: auto;
    min-height: 1fr;
    align: center top;
    hatch: cross $secondary 16%;
}

#connect-card {
    width: 72;
    max-width: 100%;
    height: auto;
    border: round $secondary;
    background: $surface;
    padding: 1 2;
}

.connect-eyebrow {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#connect-title {
    text-style: bold;
    margin-bottom: 1;
}

#connect-subtitle {
    color: $text-muted;
    margin-bottom: 1;
}

#connect-form {
    height: auto;
}

#connect-form > Select,
#connect-form > Input {
    margin-bottom: 1;
}

#connect-actions {
    height: auto;
    align: left middle;
    margin-top: 1;
}

#connect-status {
    width: 1fr;
    color: $text-muted;
    margin-right: 1;
}

#connect-status.status-warning {
    color: $warning;
}

#connect-status.status-error {
    color: $error;
}

#live-stage {
    height: 1fr;
}

.workspace-live-layout {
    layout: horizontal;
}

#workspace-meta {
    width: 1fr;
    height: 1fr;
}

#workspace-main {
    width: 2fr;
    height: 1fr;
    margin-left: 1;
}

#workspace-summary {
    height: auto;
    margin-bottom: 1;
    color: $text-muted;
    padding: 1 1;
}

/* Panels - Cockpit Style */
.panel {
    border: round $secondary;
    background: $background;
    padding: 0 1;
}

.panel:focus-within {
    border: round $accent;
}

#agent-card-container {
    height: 1fr;
}

#messages-container {
    height: 1fr;
    padding: 0 1;
}

#input-container {
    height: auto;
}

#input-row {
    height: 3;
    background: $surface;
    align: left middle;
}

#connection-target {
    width: 1fr;
    min-width: 0;
    height: 3;
    border: none;
    background: transparent;
}

#agent-url {
    background: transparent;
    border: none;
    height: 3;
    padding: 1 1;
    width: 1fr;
    min-width: 20;
}

#auth-source-status {
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

Button {
    border: none;
    height: 3;
    min-width: 0;
    background: $surface;
    color: $text;
    text-style: bold;
    content-align: center middle;
}

Button:hover {
    background: $primary;
    color: $background;
}

#placeholder {
    height: 1fr;
    width: 1fr;
    hatch: cross $secondary 30%;
    align: center middle;
    padding: 1 2;
}

#raw-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}

#agent-raw {
    height: auto;
    color: $text;
}

#message-input {
    border: none;
    height: 3;
    padding: 1 1;
    background: transparent;
    width: 1fr;
}

#send-btn,
#connect-btn {
    width: auto;
    min-width: 8;
    height: 3;
    background: $primary;
    color: $background;
}

#connect-btn {
    margin-left: 1;
}

#messages-tabs {
    height: 1fr;
}

#messages-tabs ContentSwitcher {
    height: 1fr;
}

#messages-tabs TabPane {
    height: 1fr;
    overflow-y: auto;
}

#chat {
    height: 1fr;
    scrollbar-size: 1 1;
}

Message,
AgentMessage {
    margin-bottom: 1;
    height: auto;
}

Message.message-user {
    color: $primary;
}

Message.message-system {
    color: $text-muted;
}

AgentMessage {
    color: $success;
}

#logs-panel {
    height: 1fr;
    border: none;
    padding: 0;
    scrollbar-size: 1 1;
    scrollbar-gutter: stable;
    background: $background;
    overflow-x: auto;
    overflow-y: auto;
}

#tasks-panel {
    height: 1fr;
}

#tasks-split {
    height: 1fr;
    layout: horizontal;
}

#tasks-list {
    width: 22;
    height: 1fr;
    border: none;
    scrollbar-size: 1 1;
}

#tasks-list > ListItem {
    padding: 0 1;
}

#tasks-list > ListItem:hover {
    background: $surface;
}

#tasks-list > ListItem.-highlight {
    background: $primary 30%;
}

#task-detail {
    width: 2fr;
    height: 1fr;
    border-left: solid $secondary;
    padding: 0 1;
    scrollbar-size: 1 1;
}

#task-detail-placeholder {
    color: $text-muted;
}

#task-detail-content.hidden,
#task-detail-placeholder.hidden {
    display: none;
}

#task-detail-content {
    height: auto;
}

#artifacts-panel {
    height: 1fr;
}

#artifacts-split {
    height: 1fr;
    layout: horizontal;
}

#artifacts-list {
    width: 22;
    height: 1fr;
    border: none;
    scrollbar-size: 1 1;
}

#artifacts-list > ListItem {
    padding: 0 1;
}

#artifacts-list > ListItem:hover {
    background: $surface;
}

#artifacts-list > ListItem.-highlight {
    background: $primary 30%;
}

#artifact-detail {
    width: 2fr;
    height: 1fr;
    border-left: solid $secondary;
    padding: 0 1;
    scrollbar-size: 1 1;
}

#artifact-detail-placeholder {
    color: $text-muted;
}

#artifact-detail-content.hidden,
#artifact-detail-placeholder.hidden {
    display: none;
}

#artifact-detail-content {
    height: auto;
}

.artifact-field-row {
    height: auto;
    width: auto;
}

.artifact-label {
    color: $text-muted;
}

.artifact-value {
    color: $text;
}

.artifact-content {
    height: auto;
    color: $text;
    padding: 1 0;
}

.section-heading {
    color: $accent;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.task-field-row {
    height: auto;
    width: auto;
}

.task-label {
    color: $text-muted;
}

.task-value {
    color: $text;
}

.task-value-state {
    color: $accent;
}

.artifact-id {
    color: $text;
    text-style: bold;
    margin-top: 1;
}

.artifact-preview {
    height: auto;
    color: $text-muted;
    padding-left: 2;
}

.task-item {
    height: auto;
    color: $text;
}

.history-item {
    height: auto;
    margin-top: 1;
}

.history-role-user {
    color: $primary;
    text-style: bold;
}

.history-role-agent {
    color: $success;
    text-style: bold;
}

.history-message {
    color: $text;
    padding-left: 2;
}

#auth-panel {
    height: auto;
    padding: 1;
}

#auth-panel Label {
    margin-bottom: 0;
}

#auth-panel RadioSet {
    height: auto;
    margin-bottom: 1;
}

#auth-panel Input {
    margin-bottom: 1;
}

.auth-fields {
    height: auto;
    margin-top: 1;
}

.auth-fields.hidden {
    display: none;
}

AgentCardPanel:focus {
    border: round $accent;
}

TabbedMessagesPanel:focus {
    border: round $accent;
}

Footer {
    background: transparent;
    color: $text-muted;
}

Footer > FooterKey {
    background: transparent;
    color: $text-muted;
}

Footer > FooterKey > .footer-key--key {
    background: $surface;
    color: $text-muted;
}

Footer > FooterKey > .footer-key--description {
    color: $text-muted;
}
